{
  "name": "jeuxcombat",
  "tree": {
    "$className": "DataModel",

    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Audio": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Music": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        },
        "SFX": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "Gravity": 115,
        "StreamingEnabled": false
      }
    },

    "Lighting": {
      "$properties": {
        "Technology": "Future"
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
