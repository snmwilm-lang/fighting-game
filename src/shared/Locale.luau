-- Format lines ("You need %d ki bars (you have %d)..."): matched as patterns, values kept.
local patterns = {}
local plain = {} -- first byte -> keys, longest first
local function escape(s: string): string
	return (string.gsub(s, "[%^%$%(%)%%%.%[%]%*%+%-%?]", "%%%0"))
end
for en, fr in Locale.FR do
	if string.find(en, "%%[%+%-]?%d*[ds]") then
		local pat, n = "", 0
		local i = 1
		while i <= #en do
			local s, e, spec = string.find(en, "(%%[%+%-]?%d*[ds])", i)
			if not s then
				pat ..= escape(string.sub(en, i))
				break
			end
			pat ..= escape(string.sub(en, i, s - 1)) .. (if string.sub(spec, -1) == "d" then "([%+%-]?%d+)" else "(.-)")
			n += 1
			i = e + 1
		end
		local out, k = fr, 0
		out = string.gsub(out, "%%[%+%-]?%d*[ds]", function()
			k += 1
			return "%" .. k
		end)
		out = string.gsub(out, "%%%%", "%%")
		table.insert(patterns, { "^" .. pat .. "$", out })
	elseif #en >= 2 then
		local b = string.sub(en, 1, 1)
		plain[b] = plain[b] or {}
		table.insert(plain[b], en)
	end
end
for _, list in plain do
	table.sort(list, function(a, b) return #a > #b end)
end

local function letter(c: string): boolean
	return c ~= "" and string.find(c, "[%w\128-\255]") ~= nil
end

local cache: { [string]: string } = {}
local cached = 0
function Locale.translate(text: string, lang: string?): string
	if lang ~= "FR" or text == "" then return text end
	local hit = cache[text]
	if hit then return hit end
	local out = Locale.FR[text]
	if not out then
		local trimmed = string.match(text, "^%s*(.-)%s*$") or text
		local whole = Locale.FR[trimmed]
		if whole then out = (string.match(text, "^%s*") or "") .. whole .. (string.match(text, "%s*$") or "") end
	end
	if not out then
		for _, p in patterns do
			local found = { string.match(text, p[1]) }
			if #found > 0 then
				-- (the values put in the line are translated too: "RANKED", "GOLD")
				out = string.gsub(p[2], "%%(%d)", function(k)
					local value = found[tonumber(k)] or ""
					return if tonumber(value) then value else Locale.translate(value, lang)
				end)
				break
			end
		end
	end
	if not out then
		local parts, i, n = {}, 1, #text
		while i <= n do
			local found
			if not letter(string.sub(text, i - 1, i - 1)) or i == 1 then
				for _, key in plain[string.sub(text, i, i)] or {} do
					if string.sub(text, i, i + #key - 1) == key then
						local after = string.sub(text, i + #key, i + #key)
						local last = string.sub(key, -1)
						if not letter(after) or not letter(last) then
							found = key
							break
						end
					end
				end
			end
			if found then
				table.insert(parts, Locale.FR[found])
				i += #found
			else
				table.insert(parts, string.sub(text, i, i))
				i += 1
			end
		end
		out = table.concat(parts)
	end
	if cached > 4000 then
		cache, cached = {}, 0
	end
	cache[text], cached = out, cached + 1
	return out
end

return Locale
