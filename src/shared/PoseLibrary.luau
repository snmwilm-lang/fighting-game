--[[
	Key poses of every fighter (pure data, no Roblox API, no require). The Animator turns them
	into timelines; the client runtime writes the result to the rig's Motor6D.

	Pose format: joint -> { rotX, rotY, rotZ } in degrees, applied on top of the bind pose.
	Root also takes { rotX, rotY, rotZ, offsetY, offsetZ } (offset -Z is forward).
	Rig facing is -Z: +rotX on a shoulder/hip swings the limb forward, -rotX on a knee bends it,
	+rotX on an elbow bends it, +rotY on the waist (or root) brings the right shoulder forward,
	-rotX on the waist leans forward, +rotX on the neck tilts the face up.

	Extra channels (lerped like joints):
	  Stance = { leftZ, rightZ, leftPitch, rightPitch, spread }
	           feet planted by IK: ankle depth in the root space (-Z forward), foot pitch in
	           degrees (negative = heel raised), hip spread. Only fills the legs that have no
	           explicit angles, so a kick keeps its kicking leg and plants the other one.
	  Ground = { weight }  1 = the lowest point of the body is kept on the floor (any body
	           size), 0 = the pose floats by its own Root offset (hops, flips).
	  Look   = { weight }  1 = the head turns toward the opponent.
]]
local Poses = {}

local function merge(base, changes)
	local out = table.clone(base)
	for k, v in changes do out[k] = v end
	return out
end

local LEG_JOINTS = { "LeftHip", "LeftKnee", "LeftAnkle", "RightHip", "RightKnee", "RightAnkle" }

-- Explicit leg angles (kicks, jumps, lying). Ankles keep the feet flat: ankle = -(hip + knee).
local function legs(lh, lk, rh, rk, lz, rz)
	return {
		LeftHip = { lh, 0, lz or -5 }, LeftKnee = { lk, 0, 0 }, LeftAnkle = { -(lh + lk), 0, 0 },
		RightHip = { rh, 0, rz or 5 }, RightKnee = { rk, 0, 0 }, RightAnkle = { -(rh + rk), 0, 0 },
	}
end

-- Both feet planted by IK at the given depths: removes any explicit leg angle of `base`.
local function feet(base, lz, rz, lpitch, rpitch, spread, changes)
	local out = table.clone(base)
	for _, joint in LEG_JOINTS do out[joint] = nil end
	out.Stance = { lz, rz, lpitch or 0, rpitch or 0, spread or 5 }
	for k, v in changes or {} do out[k] = v end
	return out
end

local function airborne(pose)
	pose.Ground = { 0 }
	return pose
end

local function blind(pose)
	pose.Look = { 0 }
	return pose
end

